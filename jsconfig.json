{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/frontend/*": [
        "./src/frontend/*"
      ],
      "@/backend/*": [
        "./src/backend/*"
      ],
      "@/shared/*": [
        "./src/shared/*"
      ]
    },
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "moduleResolution": "node",
    "module": "esnext",
    "target": "esnext",
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}