{
  "manifest_version": 3,
  "name": "JobScan Trust Analyzer",
  "version": "1.0.0",
  "description": "Analyze job listings for safety, scams, and credibility directly on LinkedIn, Indeed, and more.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.naukri.com/*",
    "*://*.foundit.in/*",
    "*://*.internshala.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.naukri.com/*",
        "*://*.foundit.in/*",
        "*://*.internshala.com/*"
      ],
      "js": [
        "utils/page-parser.js",
        "content/content.js"
      ]
    }
  ]
}